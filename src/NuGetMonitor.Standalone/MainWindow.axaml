<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NuGetMonitor"
        xmlns:monitor="clr-namespace:NuGetMonitor.View.Monitor"
        x:Class="NuGetMonitor.MainWindow"
        x:DataType="local:MainViewModel"
        mc:Ignorable="d"
        Title="NuGet Monitor"
        Width="1000" Height="650">

  <DockPanel>

    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4">
      <Button Content="📂 Open Solution…" Command="{Binding BrowseCommand}" />
    </StackPanel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="6,3">
      <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12" />
    </Border>

    <!-- Main content with TabControl -->
    <TabControl>
      <TabItem Header="Packages">
        <monitor:NuGetMonitorControl DataContext="{Binding NuGetMonitorViewModel}" />
      </TabItem>
      <!-- Additional tabs can be added here in the future -->
    </TabControl>

    <!-- Loading overlay -->
    <Grid IsVisible="{Binding IsLoading}"
          Background="#80000000"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ZIndex="1000">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="Loading packages…" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

  </DockPanel>
</Window>
